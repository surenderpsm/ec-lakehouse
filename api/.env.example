# Copy to .env and change for anything beyond local development.
POSTGRES_USER=ec
POSTGRES_PASSWORD=ec
GATEWAY_PORT=8080
TAG=latest

# First admin account (needed to approve vendors). Created on first start only.
BOOTSTRAP_ADMIN_EMAIL=admin@ec.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin

# JWT signing key pair, PEM with \n for newlines: scripts/generate-jwt-keys.sh >> .env
# If left empty, auth-service makes a temporary key on each start and everyone has to sign in again.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
